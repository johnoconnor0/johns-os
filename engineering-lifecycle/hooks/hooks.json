{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start-context.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/detect-stack.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/load-project-memory.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 15,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/user-prompt-intake.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask-user-question-bridge.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/dangerous-command-guard.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/secret-exfiltration-guard.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/production-environment-guard.py",
              "--hook"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/edit-scope-guard.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/generated-file-guard.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/sensitive-file-policy.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/data-model-context.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture-question-answers.py"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-new-env-vars.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-gitignore-updates.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-generated-artifacts.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sync-ledger.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/schema-drift-check.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/scripts/reference-check.py",
              "--hook"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 20,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-anomaly-check.py"
            ]
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-edit-hygiene.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hygiene-stop-check.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture-session-summary.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-completion-check.py"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sync-ledger.py",
              "--stop"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-anomaly-check.py",
              "--stop"
            ]
          },
          {
            "type": "command",
            "command": "python",
            "timeout": 30,
            "args": [
              "-B",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tracker-dispatch.py"
            ]
          }
        ]
      }
    ]
  }
}
