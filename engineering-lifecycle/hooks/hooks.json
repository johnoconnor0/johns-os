{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start-context.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/detect-stack.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/load-project-memory.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/user-prompt-intake.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ask-user-question-bridge.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/dangerous-command-guard.py\" --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/secret-exfiltration-guard.py\" --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/production-environment-guard.py\" --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/edit-scope-guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/generated-file-guard.py\" --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/sensitive-file-policy.py\" --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/data-model-context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture-question-answers.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-new-env-vars.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-gitignore-updates.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-generated-artifacts.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sync-ledger.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/schema-drift-check.py\" --hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/reference-check.py\" --hook",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-anomaly-check.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-edit-hygiene.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hygiene-stop-check.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture-session-summary.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-completion-check.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sync-ledger.py\" --stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/project-anomaly-check.py\" --stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python -B \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tracker-dispatch.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
