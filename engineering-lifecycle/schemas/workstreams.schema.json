{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/engineering-lifecycle/workstreams.schema.json",
  "title": "Triaged Workstreams",
  "description": "The surfaced-issue queue grouped into work that belongs together. Generated by triage.py compile; never hand-edited. Workstream ids are stable only for a stable input - adding an issue can legitimately renumber them, so anything needing a durable handle keys on issue_ids.",
  "type": "object",
  "required": ["generated_at", "workstreams"],
  "properties": {
    "generated_at": { "type": "string" },
    "queue_generated_at": {
      "type": "string",
      "description": "The queue timestamp this grouping was computed from. When it no longer matches the queue, the grouping is stale."
    },
    "source": {
      "type": "object",
      "properties": {
        "queue_issues": { "type": "integer", "minimum": 0 },
        "clustered": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "excluded_reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "parameters": {
      "type": "object",
      "description": "Recorded so a surprising grouping can be reproduced or re-tuned.",
      "properties": {
        "merge_threshold": { "type": "number" },
        "max_size": { "type": "integer", "minimum": 1 },
        "weights": { "type": "object" }
      },
      "additionalProperties": true
    },
    "truncated": { "type": "boolean" },
    "cycles": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "issue_ids", "severity", "size", "parallel_safe", "parallel_safe_reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^ws-" },
          "title": { "type": "string", "minLength": 1 },
          "title_confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "issue_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "identifiers": { "type": "array", "items": { "type": "string" } },
          "initiative_id": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "size": { "type": "integer", "minimum": 1 },
          "labels": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "path_evidence": {
            "type": "string",
            "enum": ["declared", "derived", "none"],
            "description": "declared: a detector recorded the path. derived: extracted from issue text and verified to exist on disk. none: no path evidence, which forces parallel_safe false - unknown is not safe."
          },
          "suggested_agent": { "type": "string" },
          "agent_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "depends_on": { "type": "array", "items": { "type": "object" } },
          "conflicts_with": { "type": "array", "items": { "type": "object" } },
          "wave": { "type": "integer", "minimum": 0 },
          "parallel_safe": { "type": "boolean" },
          "parallel_safe_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Never empty. A gate with no stated reason is a gate people override without reading it."
          },
          "merge_evidence": {
            "type": "array",
            "description": "The strongest pairings that formed this cluster, so a wrong grouping is debuggable rather than magic.",
            "items": { "type": "object" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
