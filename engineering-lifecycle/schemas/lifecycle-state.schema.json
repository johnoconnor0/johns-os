{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/engineering-lifecycle/lifecycle-state.schema.json",
  "title": "Engineering Lifecycle State",
  "type": "object",
  "required": ["generated_at", "initiative_id", "current_stage", "stages"],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "initiative_id": { "type": "string", "minLength": 1 },
    "current_stage": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["missing", "draft", "reviewed", "approved", "implemented", "superseded"]
          },
          "artifact_paths": { "type": "array", "items": { "type": "string" } },
          "gaps": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
