#!/usr/bin/env python3
"""Run Engineering Lifecycle hygiene detection and optional safe updates."""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def run(script: str, root: Path, *args: str) -> int:
    # -B keeps __pycache__ out of the installed plugin directory.
    return subprocess.call([sys.executable, "-B", str(ROOT / script), *args], cwd=root)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=None, help="Target project root. Defaults to the current working directory.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("detect")
    sub.add_parser("apply-env")
    args = parser.parse_args()
    root = Path(args.root).resolve() if args.root else Path.cwd().resolve()
    if args.command == "detect":
        # Explicit CLI request: create the repo-root workspace on demand. The same
        # scripts stay dormant when fired as automatic PostToolUse hooks (no flag).
        code = run("hooks/scripts/detect-new-env-vars.py", root, "--ensure-workspace")
        code = run("hooks/scripts/suggest-gitignore-updates.py", root, "--ensure-workspace") or code
        return code
    if args.command == "apply-env":
        return run("hooks/scripts/update-env-example.py", root, "--apply")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
