#!/usr/bin/env python3
"""Engineering Lifecycle command entrypoint."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def target_root(value: str | None) -> Path:
    return Path(value).resolve() if value else Path.cwd().resolve()


def run(script: str, root: Path, *args: str) -> int:
    # -B keeps __pycache__ out of the installed plugin directory.
    return subprocess.call([sys.executable, "-B", str(ROOT / script), "--root", str(root), *args], cwd=root)


def status(root: Path) -> int:
    ledger = root / ".project" / ".engineering" / "ledger" / "ledger.json"
    if not ledger.exists():
        print("No ledger found. Run `eng-life sync-ledger` first.")
        return 0
    data = json.loads(ledger.read_text(encoding="utf-8"))
    print(json.dumps(data.get("summary", {}), indent=2, sort_keys=True))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=None, help="Target project root. Defaults to the current working directory.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init")
    sub.add_parser("validate")
    sub.add_parser("sync-ledger")
    sub.add_parser("build-dashboard")
    sub.add_parser("status")
    linear_parser = sub.add_parser("linear-sync")
    linear_parser.add_argument("action", choices=["plan", "pending", "reconcile", "apply-pull"])
    linear_parser.add_argument("--results")
    linear_parser.add_argument("--updates")
    # The provider-agnostic successor to linear-sync. That one stays for anyone
    # scripting against it; this is the one that works with a tracker other than
    # Linear, and with no tracker at all.
    tracker_parser = sub.add_parser("tracker")
    tracker_parser.add_argument(
        "action",
        choices=["init", "status", "pending", "list", "plan", "record", "reconcile", "resolve", "on", "off"],
    )
    tracker_parser.add_argument("--results")
    tracker_parser.add_argument("--title")
    tracker_parser.add_argument("--severity")
    tracker_parser.add_argument("--id")
    tracker_parser.add_argument("--include-ledger", action="store_true")
    args = parser.parse_args()
    root = target_root(args.root)
    if args.command == "init":
        return run("scripts/init-workspace.py", root)
    if args.command == "validate":
        code = subprocess.call(
            [sys.executable, "-B", str(ROOT / "scripts" / "validate-plugin.py"), "--root", str(ROOT)], cwd=ROOT
        )
        code = (
            subprocess.call(
                [sys.executable, "-B", str(ROOT / "scripts" / "validate-schemas.py"), "--root", str(ROOT)], cwd=ROOT
            )
            or code
        )
        return code
    if args.command in {"sync-ledger", "build-dashboard"}:
        return run("scripts/sync-ledger.py", root)
    if args.command == "status":
        return status(root)
    if args.command == "linear-sync":
        extra: list[str] = []
        if args.results:
            extra += ["--results", args.results]
        if args.updates:
            extra += ["--updates", args.updates]
        return run("scripts/linear-sync.py", root, args.action, *extra)
    if args.command == "tracker":
        extra = []
        for flag, value in (
            ("--results", args.results),
            ("--title", args.title),
            ("--severity", args.severity),
            ("--id", args.id),
        ):
            if value:
                extra += [flag, value]
        if args.include_ledger:
            extra.append("--include-ledger")
        return run("scripts/surface-issue.py", root, args.action, *extra)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
