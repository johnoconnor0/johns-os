#!/usr/bin/env python3
"""CLI wrapper for scripts/council.py."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "scripts" / "council.py"
CALLER_ROOT = Path.cwd().resolve()

args = [*sys.argv[1:]]
if "--root" not in args:
    args.extend(["--root", str(CALLER_ROOT)])

raise SystemExit(subprocess.call([sys.executable, str(SCRIPT), *args], cwd=CALLER_ROOT))
