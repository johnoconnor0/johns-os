# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for JSON and Markdown
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf

# Anything a Linux container reads. A CRLF checkout on Windows reaches container
# bash as `$'\r': command not found` followed by a syntax error, which reads like
# a broken script rather than a broken checkout - and the seeds are bind-mounted
# straight from the working tree, so git's normalisation is the only thing
# standing between a Windows clone and a confusing failure.
*.sql       text eol=lf
*.js        text eol=lf
Dockerfile* text eol=lf

# The CLI entry points. These carry `#!/usr/bin/env python3` and go on PATH when
# the plugin is installed, so a CRLF checkout makes the kernel look for an
# interpreter literally named `python3\r` and report `bad interpreter` - on the
# one code path a user runs by hand. Every other executable here is pinned by
# its extension; these four have none, so `text=auto` was the only thing holding
# them, and it had already let `bin/eng-life` drift to CRLF in the working tree.
#
# `**/bin/*`, not `bin/*`: a gitattributes pattern containing a slash is anchored
# to the directory holding the file, so `bin/*` would only ever match a top-level
# `bin/` this repository does not have - it would look correct and match nothing.
**/bin/*    text eol=lf
