# Engineering Lifecycle plugin — generated runtime workspace for this repo.
# Created by the plugin's SessionStart hook; pure runtime state, not source.
# (The plugin's own workspace under engineering-lifecycle/.project/ is ignored
# by engineering-lifecycle/.gitignore. The leading slash anchors this rule to
# the repo root only.)
#
# settings.json is the one exception: it is hand-authored, intentional, and
# belongs to the project rather than to a session. Git cannot re-include a file
# whose parent directory is excluded, so the whole stanza has to be spelled out
# rather than a single negation added.
/.project/*
!/.project/.engineering/
/.project/.engineering/*
!/.project/.engineering/settings.json
/docs/
/NOTES.md

# Node: the CLI package and the dashboard e2e suite are the only Node in the repo
node_modules/
package-lock.json
cli/*.tgz
# Written by cli's prepack from .claude-plugin/marketplace.json, because `files`
# cannot reach a parent directory. Generated, never edited.
cli/marketplace.json

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.venv/
venv/
.coverage
coverage/
dist/
build/
*.egg-info/

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account.json

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
